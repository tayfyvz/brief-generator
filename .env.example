# --- Required ---------------------------------------------------------------
# Postgres connection string. docker-compose sets this automatically for the
# containerized app; this value is for running `next dev` against compose PG
# (host port 5433 to avoid colliding with other local Postgres instances).
DATABASE_URL=postgres://brief:brief@localhost:5433/brief

# --- External API keys (all optional) ---------------------------------------
# Missing key => the corresponding tool client runs as a stub (PLAN: never
# block on a missing key). Provide real keys to enable live research.
# LLM provider — set one; Anthropic wins when both are present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Per-run hard caps (PLAN §2, defaults shown) ----------------------------
MAX_ROUNDS=12
MAX_SEARCHES_PER_RUN=100
MAX_FETCHES_PER_RUN=60

# --- Global abuse guards (public demo endpoint) -----------------------------
MAX_CONCURRENT_RUNS=3
DAILY_RUN_LIMIT=25
RATE_LIMIT_RUNS_PER_IP_PER_HOUR=5
